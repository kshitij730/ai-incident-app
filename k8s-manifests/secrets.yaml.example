apiVersion: v1
kind: Secret
metadata:
  name: aiops-secrets
type: Opaque
stringData:
  PINECONE_API_KEY: "REPLACE_WITH_YOUR_PINECONE_KEY"
  HF_API_TOKEN: "REPLACE_WITH_YOUR_HF_TOKEN"
  SLACK_WEBHOOK_URL: "REPLACE_WITH_YOUR_SLACK_WEBHOOK"
  JIRA_BASE_URL: "REPLACE_WITH_YOUR_JIRA_URL"
  JIRA_EMAIL: "REPLACE_WITH_YOUR_EMAIL"
  JIRA_API_TOKEN: "REPLACE_WITH_YOUR_JIRA_TOKEN"
